generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  FRONT_DESK
  DOCTOR
  CLINIC_ADMIN
  HOLDING_ADMIN
}

enum Sex {
  MALE
  FEMALE
}

enum QueueStatus {
  BOOKED
  CHECKED_IN
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum QueuePriority {
  NORMAL
  PRIORITY
}

enum QueueSource {
  FACEBOOK
  WALK_IN
  PHONE
  ONLINE
}

enum MedicineForm {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  OINTMENT
  OTHER
}

enum MedicineUnit {
  PIECE
  BOTTLE
  VIAL
  SACHET
  BOX
}

enum StockMovementType {
  RECEIPT
  DISPENSE
  ADJUSTMENT
  RETURN
  EXPIRED
  DAMAGED
}

enum PaymentMethod {
  CASH
  GCASH
  CARD
  HMO
  OTHER
}

enum NotificationChannel {
  SMS
  MESSENGER
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  MOCKED
}

// ─────────────────────────────────────────────────────────────────────────
// Holding company / clinic
// ─────────────────────────────────────────────────────────────────────────

model HoldingCompany {
  id           String   @id @default(uuid())
  name         String
  contactName  String?  @map("contact_name")
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  clinics Clinic[]
  users   User[]

  @@map("holding_companies")
}

model Clinic {
  id               String          @id @default(uuid())
  holdingCompanyId String?         @map("holding_company_id")
  holdingCompany   HoldingCompany? @relation(fields: [holdingCompanyId], references: [id])
  name             String
  slug             String          @unique
  address          String
  city             String
  phone            String
  facebookPageUrl  String?         @map("facebook_page_url")
  timezone         String          @default("Asia/Manila")
  // JSON keyed by weekday ("mon".."sun") -> { open: "09:00", close: "18:00" } | null when closed
  operatingHours   Json            @map("operating_hours")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  users              User[]
  doctors            Doctor[]
  patients           Patient[]
  queueEntries       QueueEntry[]
  consultations      Consultation[]
  medicines          Medicine[]
  stockMovements     StockMovement[]
  medicinesDispensed MedicineDispensed[]
  payments           Payment[]
  remittances        Remittance[]
  expenses           Expense[]
  notifications      Notification[]
  auditLogs          AuditLog[]

  @@map("clinics")
}

// ─────────────────────────────────────────────────────────────────────────
// Users / doctors
// ─────────────────────────────────────────────────────────────────────────

model User {
  id                  String          @id @default(uuid())
  clinicId            String?         @map("clinic_id")
  clinic              Clinic?         @relation(fields: [clinicId], references: [id])
  holdingCompanyId    String?         @map("holding_company_id")
  holdingCompany      HoldingCompany? @relation(fields: [holdingCompanyId], references: [id])
  name                String
  email               String          @unique
  phone               String?
  passwordHash        String          @map("password_hash")
  role                Role
  isActive            Boolean         @default(true) @map("is_active")
  mustChangePassword  Boolean         @default(true) @map("must_change_password")
  failedLoginAttempts Int             @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?       @map("locked_until")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  doctor               Doctor?
  paymentsCollected    Payment[]       @relation("PaymentCollectedBy")
  remittances          Remittance[]    @relation("RemittanceUser")
  remittancesConfirmed Remittance[]    @relation("RemittanceConfirmedBy")
  expensesRecorded     Expense[]
  stockMovementsMade   StockMovement[]
  auditLogs            AuditLog[]

  @@map("users")
}

model Doctor {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  user             User     @relation(fields: [userId], references: [id])
  clinicId         String   @map("clinic_id")
  clinic           Clinic   @relation(fields: [clinicId], references: [id])
  licenseNumber    String   @map("license_number")
  specialization   String   @default("General Practitioner")
  // centavos
  consultationFee  Int      @map("consultation_fee")
  isAvailableToday Boolean  @default(true) @map("is_available_today")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  queueEntries  QueueEntry[]
  consultations Consultation[]

  @@map("doctors")
}

// ─────────────────────────────────────────────────────────────────────────
// Patients
// ─────────────────────────────────────────────────────────────────────────

model Patient {
  id                    String    @id @default(uuid())
  clinicId              String    @map("clinic_id")
  clinic                Clinic    @relation(fields: [clinicId], references: [id])
  firstName             String    @map("first_name")
  lastName              String    @map("last_name")
  middleName            String?   @map("middle_name")
  birthdate             DateTime  @db.Date
  sex                   Sex
  phone                 String
  email                 String?
  address               String
  emergencyContactName  String    @map("emergency_contact_name")
  emergencyContactPhone String    @map("emergency_contact_phone")
  // required in the booking/registration form when the patient is a minor
  guardianName          String?   @map("guardian_name")
  guardianPhone         String?   @map("guardian_phone")
  facebookPsid          String?   @map("facebook_psid")
  notes                 String?
  // Data Privacy Act (RA 10173) consent — recorded at booking/registration
  consentAt             DateTime? @map("consent_at")
  createdById           String?   @map("created_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  queueEntries  QueueEntry[]
  consultations Consultation[]
  payments      Payment[]
  notifications Notification[]

  @@index([clinicId, phone])
  @@index([clinicId, lastName, firstName])
  @@map("patients")
}

// ─────────────────────────────────────────────────────────────────────────
// Queue
// ─────────────────────────────────────────────────────────────────────────

model QueueEntry {
  id             String        @id @default(uuid())
  clinicId       String        @map("clinic_id")
  clinic         Clinic        @relation(fields: [clinicId], references: [id])
  patientId      String        @map("patient_id")
  patient        Patient       @relation(fields: [patientId], references: [id])
  doctorId       String?       @map("doctor_id")
  doctor         Doctor?       @relation(fields: [doctorId], references: [id])
  queueNumber    Int           @map("queue_number")
  queueDate      DateTime      @map("queue_date") @db.Date
  status         QueueStatus   @default(BOOKED)
  priority       QueuePriority @default(NORMAL)
  source         QueueSource
  reasonForVisit String?       @map("reason_for_visit")
  checkedInAt    DateTime?     @map("checked_in_at")
  calledAt       DateTime?     @map("called_at")
  startedAt      DateTime?     @map("started_at")
  completedAt    DateTime?     @map("completed_at")
  // cryptographically random, single-purpose; expires end of day (queueDate)
  accessToken    String        @unique @map("access_token")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  consultations Consultation[]
  notifications Notification[]

  @@unique([clinicId, queueDate, queueNumber])
  @@index([clinicId, queueDate, status])
  @@map("queue_entries")
}

// ─────────────────────────────────────────────────────────────────────────
// Consultations (append-only in spirit: edits insert a new revision row)
// ─────────────────────────────────────────────────────────────────────────

model Consultation {
  id             String     @id @default(uuid())
  queueEntryId   String     @map("queue_entry_id")
  queueEntry     QueueEntry @relation(fields: [queueEntryId], references: [id])
  patientId      String     @map("patient_id")
  patient        Patient    @relation(fields: [patientId], references: [id])
  doctorId       String     @map("doctor_id")
  doctor         Doctor     @relation(fields: [doctorId], references: [id])
  clinicId       String     @map("clinic_id")
  clinic         Clinic     @relation(fields: [clinicId], references: [id])
  chiefComplaint String     @map("chief_complaint")
  // { bp, temp, weight, height, pulse }
  vitals         Json?
  findings       String?
  diagnosis      String?
  treatmentPlan  String?    @map("treatment_plan")
  followUpDate   DateTime?  @map("follow_up_date") @db.Date
  // increments when an edit creates a new revision instead of overwriting
  revisionNumber Int        @default(1) @map("revision_number")
  createdAt      DateTime   @default(now()) @map("created_at")
  deletedAt      DateTime?  @map("deleted_at")

  medicinesDispensed MedicineDispensed[]
  payments           Payment[]

  @@index([patientId, createdAt])
  @@index([queueEntryId, revisionNumber])
  @@map("consultations")
}

// ─────────────────────────────────────────────────────────────────────────
// Medicine inventory
// ─────────────────────────────────────────────────────────────────────────

model Medicine {
  id           String       @id @default(uuid())
  clinicId     String       @map("clinic_id")
  clinic       Clinic       @relation(fields: [clinicId], references: [id])
  name         String
  genericName  String?      @map("generic_name")
  form         MedicineForm
  strength     String?
  unit         MedicineUnit
  // cached running total — must only change via a StockMovement row
  currentStock Int          @default(0) @map("current_stock")
  reorderLevel Int          @default(0) @map("reorder_level")
  // centavos
  unitCost     Int          @map("unit_cost")
  sellingPrice Int          @map("selling_price")
  expiryDate   DateTime?    @map("expiry_date") @db.Date
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  stockMovements     StockMovement[]
  medicinesDispensed MedicineDispensed[]

  @@index([clinicId, isActive])
  @@map("medicines")
}

model StockMovement {
  id                String            @id @default(uuid())
  clinicId          String            @map("clinic_id")
  clinic            Clinic            @relation(fields: [clinicId], references: [id])
  medicineId        String            @map("medicine_id")
  medicine          Medicine          @relation(fields: [medicineId], references: [id])
  movementType      StockMovementType @map("movement_type")
  // signed: positive for receipt/return, negative for dispense/adjustment-down/expired/damaged
  quantityChange    Int               @map("quantity_change")
  balanceAfter      Int               @map("balance_after")
  referenceType     String?           @map("reference_type")
  referenceId       String?           @map("reference_id")
  reason            String?
  performedByUserId String            @map("performed_by_user_id")
  performedByUser   User              @relation(fields: [performedByUserId], references: [id])
  createdAt         DateTime          @default(now()) @map("created_at")

  medicineDispensed MedicineDispensed?

  @@index([clinicId, medicineId, createdAt])
  @@map("stock_movements")
}

model MedicineDispensed {
  id              String         @id @default(uuid())
  consultationId  String         @map("consultation_id")
  consultation    Consultation   @relation(fields: [consultationId], references: [id])
  medicineId      String?        @map("medicine_id")
  medicine        Medicine?      @relation(fields: [medicineId], references: [id])
  // denormalized so the clinical record still reads correctly if the
  // medicine is later renamed/deactivated
  medicineName    String         @map("medicine_name")
  dosage          String?
  quantity        Int
  instructions    String?
  // centavos, nullable ("prescribed only" rows have no clinic-set price)
  unitPrice       Int?           @map("unit_price")
  notes           String?
  stockMovementId String?        @unique @map("stock_movement_id")
  stockMovement   StockMovement? @relation(fields: [stockMovementId], references: [id])
  createdAt       DateTime       @default(now()) @map("created_at")
  deletedAt       DateTime?      @map("deleted_at")

  clinicId String @map("clinic_id")
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  @@map("medicines_dispensed")
}

// ─────────────────────────────────────────────────────────────────────────
// Payments / remittance / expenses
// ─────────────────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(uuid())
  clinicId          String        @map("clinic_id")
  clinic            Clinic        @relation(fields: [clinicId], references: [id])
  consultationId    String?       @map("consultation_id")
  consultation      Consultation? @relation(fields: [consultationId], references: [id])
  patientId         String        @map("patient_id")
  patient           Patient       @relation(fields: [patientId], references: [id])
  // centavos
  amount            Int
  paymentMethod     PaymentMethod @default(CASH) @map("payment_method")
  collectedByUserId String        @map("collected_by_user_id")
  collectedByUser   User          @relation("PaymentCollectedBy", fields: [collectedByUserId], references: [id])
  receivedAt        DateTime      @default(now()) @map("received_at")
  orNumber          String?       @map("or_number")
  notes             String?
  createdAt         DateTime      @default(now()) @map("created_at")

  @@index([clinicId, receivedAt])
  @@index([collectedByUserId, receivedAt])
  @@map("payments")
}

model Remittance {
  id                String   @id @default(uuid())
  clinicId          String   @map("clinic_id")
  clinic            Clinic   @relation(fields: [clinicId], references: [id])
  userId            String   @map("user_id")
  user              User     @relation("RemittanceUser", fields: [userId], references: [id])
  shiftDate         DateTime @map("shift_date") @db.Date
  // centavos
  expectedAmount    Int      @map("expected_amount")
  actualAmount      Int      @map("actual_amount")
  variance          Int
  remittedAt        DateTime @default(now()) @map("remitted_at")
  confirmedByUserId String?  @map("confirmed_by_user_id")
  confirmedByUser   User?    @relation("RemittanceConfirmedBy", fields: [confirmedByUserId], references: [id])
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([clinicId, shiftDate])
  @@map("remittances")
}

model Expense {
  id               String   @id @default(uuid())
  clinicId         String   @map("clinic_id")
  clinic           Clinic   @relation(fields: [clinicId], references: [id])
  category         String
  description      String?
  // centavos
  amount           Int
  expenseDate      DateTime @map("expense_date") @db.Date
  recordedByUserId String   @map("recorded_by_user_id")
  recordedByUser   User     @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([clinicId, expenseDate])
  @@map("expenses")
}

// ─────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id                String              @id @default(uuid())
  clinicId          String              @map("clinic_id")
  clinic            Clinic              @relation(fields: [clinicId], references: [id])
  patientId         String              @map("patient_id")
  patient           Patient             @relation(fields: [patientId], references: [id])
  queueEntryId      String?             @map("queue_entry_id")
  queueEntry        QueueEntry?         @relation(fields: [queueEntryId], references: [id])
  channel           NotificationChannel
  templateKey       String              @map("template_key")
  payload           Json
  status            NotificationStatus  @default(QUEUED)
  providerMessageId String?             @map("provider_message_id")
  error             String?
  sentAt            DateTime?           @map("sent_at")
  createdAt         DateTime            @default(now()) @map("created_at")

  @@index([clinicId, createdAt])
  @@index([patientId, createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────
// Audit log
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  clinicId   String?  @map("clinic_id")
  clinic     Clinic?  @relation(fields: [clinicId], references: [id])
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  changes    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([clinicId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
