# Database (Supabase Postgres in prod — Singapore region; local Postgres in dev)
# Used by `prisma migrate`/`prisma generate` only — needs DDL privileges.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stretchlab_dev"

# Runtime app connection — MUST be a non-superuser role or Postgres Row
# Level Security silently no-ops (superusers always bypass RLS). See
# DECISIONS.md for how the local `webinar_app` role was created.
APP_DATABASE_URL="postgresql://webinar_app:CHANGE_ME@localhost:5432/stretchlab_dev"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Supabase Storage (private buckets, signed URLs) — required once file uploads are wired
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Notification providers (dev uses the console-logging driver — leave blank locally)
SEMAPHORE_API_KEY=""
MOVIDER_API_KEY=""
RESEND_API_KEY=""
META_PAGE_ACCESS_TOKEN=""
META_APP_SECRET=""
META_LEAD_WEBHOOK_VERIFY_TOKEN=""
VIBER_BSP_API_KEY=""
