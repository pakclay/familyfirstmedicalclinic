# Database (local Postgres in dev; point at your real host in prod)
# Used by `prisma migrate`/`prisma generate` only (prisma.config.ts) — needs
# DDL privileges.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/familyfirst_dev"

# Runtime app connection — MUST be a non-superuser role or Postgres Row
# Level Security silently no-ops (superusers always bypass RLS). See
# DECISIONS.md for how the local `webinar_app` role was created.
#
# In production on Supabase + Vercel this MUST be the pooler in TRANSACTION
# mode — port 6543, with ?connection_limit=5 — never session mode (port
# 5432), which caps clients at pool_size and fails under a few warm
# instances. DATABASE_URL above stays on the direct/session connection:
# Prisma Migrate needs one. See lib/db/prisma.ts and DECISIONS.md 2026-09-06.
#
# The app talks to Postgres through node-postgres (lib/db/client-factory.ts):
# `connection_limit` becomes the pool's `max`; `?pgbouncer=true` is harmless
# but no longer does anything; a remote host is encrypted without certificate
# verification unless the URL states its own `sslmode` (use
# `sslmode=verify-full&sslrootcert=<path>` to verify).
#   APP_DATABASE_URL="postgresql://webinar_app.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?connection_limit=5"
APP_DATABASE_URL="postgresql://webinar_app:CHANGE_ME@localhost:5432/familyfirst_dev"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Notification providers (§7.6) — dev uses the console-logging MockChannel by
# default; leave these blank locally. Set NOTIFICATION_CHANNEL=sms/messenger
# to switch a real provider on.
NOTIFICATION_CHANNEL="mock"
SEMAPHORE_API_KEY=""
META_PAGE_ACCESS_TOKEN=""
META_APP_SECRET=""
