# Database (local Postgres in dev; point at your real host in prod)
# Used by `prisma migrate`/`prisma generate` only — needs DDL privileges.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/familyfirst_dev"

# Runtime app connection — MUST be a non-superuser role or Postgres Row
# Level Security silently no-ops (superusers always bypass RLS). See
# DECISIONS.md for how the local `webinar_app` role was created.
APP_DATABASE_URL="postgresql://webinar_app:CHANGE_ME@localhost:5432/familyfirst_dev"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Notification providers (§7.6) — dev uses the console-logging MockChannel by
# default; leave these blank locally. Set NOTIFICATION_CHANNEL=sms/messenger
# to switch a real provider on.
NOTIFICATION_CHANNEL="mock"
SEMAPHORE_API_KEY=""
META_PAGE_ACCESS_TOKEN=""
META_APP_SECRET=""
